# EAS Build Ignore File
# Exclude unnecessary files from build uploads to reduce archive size

# Development and documentation files
README*.md
BUILD*.md
*.bat
*.ps1
CHANGELOG.md
TODO.md
NOTES.md
clear-ts-cache.bat

# Git files
.git/
.gitignore
.gitattributes

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.settings/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Dependencies cache (will be installed during build)
node_modules/.cache/

# Test files
__tests__/
__mocks__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
coverage/
.nyc_output/

# Build artifacts (local)
.expo/
dist/
build/
.next/
out/

# Cache files
.eslintcache
*.tsbuildinfo
.turbo/
tsconfig.tsbuildinfo

# Environment files (secrets should use EAS Secrets instead)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup

# Large media files not needed (if any mock/sample files)
samples/
examples/

# Documentation images and assets
docs/
screenshots/
.github/
images/

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.circleci/

# Package manager files (not needed in build)
yarn.lock
package-lock.json
pnpm-lock.yaml

# Expo web build
web-build/
.expo-shared/

# Android/iOS build folders (if present locally)
android/build/
android/app/build/
android/.gradle/
ios/build/
ios/Pods/
ios/DerivedData/

# Miscellaneous
.prettier*
.editorconfig
.eslintignore
.gitkeep

# Source maps (if you don't need them in production)
*.map

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
